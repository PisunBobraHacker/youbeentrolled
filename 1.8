-- ===== lookTurn =====
local function getLookTurn(targetHRP, myHRP)
    local dir = (targetHRP.Position - myHRP.Position).Unit
    local localDir = myHRP.CFrame:VectorToObjectSpace(dir)
    local yaw = math.atan2(-localDir.X, -localDir.Z)
    local pitch = math.asin(localDir.Y)
    return Vector2.new(math.deg(yaw), math.deg(pitch))
end

-- ===== Тики =====
local lastUpdateTick = math.floor(os.clock() * settings.tickRate)
local function buildPayload(id, lookTurn)
    local now = os.clock()
    local current = math.floor(now * settings.tickRate)
    local from = lastUpdateTick; lastUpdateTick = current
    return {
        id = id, lookTurn = lookTurn, updateTick = current, fromUpdateTick = from,
        tick = current, time = now, swing = true, tickRate = settings.tickRate,
        combat = true, attack = true,
    }
end

-- ===== Aimbot tick =====
local function aimbotTick()
    if not settings.aimbotEnabled then
        currentAimbotTargets = {}; currentAimbotTarget = nil; currentAttackTargets = {}; return
    end
    if settings.multiAimEnabled then
        currentAimbotTargets = getNearestN(settings.multiAimCount, settings.aimbotRange)
        currentAttackTargets = getAttackableN(settings.multiAimCount, settings.hitRange)
    else
        currentAimbotTargets = getNearestN(1, settings.aimbotRange)
        currentAttackTargets = getAttackableN(1, settings.hitRange)
    end
    currentAimbotTarget = currentAimbotTargets[1]
end
RunService.RenderStepped:Connect(aimbotTick)

-- ===== Silent Aura (ОПТИМИЗИРОВАНО) =====
local lastSilentAura = 0
local silentAuraHitsPerTarget = 3
local silentAuraHitDelay = 0.02

RunService.Heartbeat:Connect(function()
    if not settings.silentAuraEnabled then return end
    if tick() - lastSilentAura < settings.silentAuraDelay then return end

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    local targetsInRange = {}
    for _, target in ipairs(currentAimbotTargets) do
        if target.Character then
            local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
            if targetHRP then
                local dist = (myHRP.Position - targetHRP.Position).Magnitude
                if dist <= settings.hitRange then
                    table.insert(targetsInRange, {target = target, hrp = targetHRP})
                end
            end
        end
    end

    if #targetsInRange == 0 then return end

    local er = nil
    if settings.aimbotMode == "Advanced" then
        er = getEntityRenderer()
    end

    for _, entry in ipairs(targetsInRange) do
        local target = entry.target
        local targetHRP = entry.hrp
        local lookTurn = getLookTurn(targetHRP, myHRP)

        local payload
        if er and er.getPlayerEntityId then
            local ok, id = pcall(er.getPlayerEntityId, target)
            if ok and id then
                payload = buildPayload(id, lookTurn)
            end
        end

        if not payload then
            local now = os.clock()
            local current = math.floor(now * settings.tickRate)
            payload = {
                lookTurn = lookTurn,
                updateTick = current,
                fromUpdateTick = current - 1,
                tick = current,
                time = now,
                swing = true,
                tickRate = settings.tickRate,
                combat = true,
                attack = true,
            }
        end

        for hit = 1, silentAuraHitsPerTarget do
            pcall(function() attackRemote:FireServer(payload) end)
        end
        log("Silent Aura: " .. target.Name .. " x" .. silentAuraHitsPerTarget)
    end

    lastSilentAura = tick()
end)

-- ===== Packet Crit =====
local function doPacketCrit()
    if not moveRemote then return end
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    packetCritActive = true
    pcall(function() moveRemote:FireServer("~N", myHRP.Position, 0, 0, "standing", false, true, false, 0) end)
    task.wait(0.01)
    pcall(function() moveRemote:FireServer("~N", myHRP.Position, 0, 0, "standing", true, false, false, 0) end)
    packetCritActive = false
end

-- ===== Anti-Aim (каждый кадр) =====
local antiAimSpin = 0
local originalNeckC0, originalWaistC0 = nil, nil
local function getJoints()
    local char = LocalPlayer.Character
    if not char then return nil end
    local head = char:FindFirstChild("Head")
    local upperTorso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not (head and upperTorso) then return nil end
    return {
        neck = head:FindFirstChild("Neck"),
        waist = upperTorso:FindFirstChild("Waist"),
        char = char,
    }
end
RunService.RenderStepped:Connect(function(dt)
    local j = getJoints()
    if not j then return end
    if j.neck and not originalNeckC0 then originalNeckC0 = j.neck.C0 end
    if j.waist and not originalWaistC0 then originalWaistC0 = j.waist.C0 end
    if not settings.antiAimEnabled then
        if originalNeckC0 and j.neck then j.neck.C0 = originalNeckC0 end
        if originalWaistC0 and j.waist then j.waist.C0 = originalWaistC0 end
        return
    end
    local hrp = j.char:FindFirstChild("HumanoidRootPart")
    if hrp then
        antiAimSpin = antiAimSpin + dt * 8
        local pos = hrp.Position
        hrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, antiAimSpin, 0)
    end
    if j.neck and originalNeckC0 then
        j.neck.C0 = originalNeckC0 * CFrame.Angles(math.rad(-80), 0, 0)
    end
    if j.waist and originalWaistC0 then
        j.waist.C0 = originalWaistC0 * CFrame.Angles(math.rad(-30), 0, 0)
    end
end)

-- ===== Частицы от целей Aimbot (каждый кадр) =====
local targetParticles = {}
local function createTargetParticles(character)
    if targetParticles[character] then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local att = Instance.new("Attachment"); att.Parent = hrp
    local pe = Instance.new("ParticleEmitter"); pe.Parent = att
    pe.Texture = "rbxassetid://243098098"
    pe.LightEmission = 1; pe.LightInfluence = 0
    pe.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
    pe.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1.8),
        NumberSequenceKeypoint.new(0.5, 1.2),
        NumberSequenceKeypoint.new(1, 0)
    })
    pe.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.7, 0.3),
        NumberSequenceKeypoint.new(1, 1)
    })
    pe.Lifetime = NumberRange.new(2, 3.5)
    pe.Rate = 250
    pe.Speed = NumberRange.new(1, 2.5)
    pe.SpreadAngle = Vector2.new(180, 180)
    pe.Acceleration = Vector3.new(0, 1.5, 0)
    pe.Drag = 2.5
    pe.LockedToPart = false
    pe.VelocityInheritance = 2
    pe.Rotation = NumberRange.new(0, 360)
    pe.RotSpeed = NumberRange.new(-90, 90)
    targetParticles[character] = {att = att, pe = pe}
end
local function removeTargetParticles(character)
    local data = targetParticles[character]
    if data then
        if data.att then data.att:Destroy() end
        targetParticles[character] = nil
    end
end
RunService.RenderStepped:Connect(function()
    if not settings.particlesEnabled then
        for char, _ in pairs(targetParticles) do removeTargetParticles(char) end
        return
    end
    local activeChars = {}
    for _, target in ipairs(currentAimbotTargets) do
        local char = target.Character
        if char then
            activeChars[char] = true
            createTargetParticles(char)
            local data = targetParticles[char]
            if data and data.pe then
                data.pe.Rate = 250
                data.pe.Enabled = true
            end
        end
    end
    for char, _ in pairs(targetParticles) do
        if not activeChars[char] then removeTargetParticles(char) end
    end
end)

-- ===== Шляпа-гуру (пирамида из 4 частей) =====
local hatModel = Instance.new("Model"); hatModel.Name = "GuruHat"
local hatBase = Instance.new("Part")
hatBase.Name = "HatBase"; hatBase.Size = Vector3.new(2.2, 0.2, 2.2); hatBase.Shape = Enum.PartType.Block
hatBase.Color = Color3.fromRGB(255, 255, 255); hatBase.Material = Enum.Material.Neon
hatBase.Transparency = 0.5; hatBase.CanCollide = false; hatBase.Massless = true; hatBase.Parent = hatModel

local coneParts = {}
for i = 1, 4 do
    local part = Instance.new("Part")
    part.Name = "PyramidSide" .. i; part.Size = Vector3.new(1.1, 2, 0.2)
    part.Color = Color3.fromRGB(255, 255, 255); part.Material = Enum.Material.Neon
    part.Transparency = 0.5; part.CanCollide = false; part.Massless = true; part.Parent = hatModel
    table.insert(coneParts, part)
end
hatModel.Parent = game.CoreGui

local function attachHat(char)
    local head = char:FindFirstChild("Head")
    if head and not head:FindFirstChild("GuruHatWeldBase") then
        hatModel.Parent = char
        hatBase.CFrame = head.CFrame * CFrame.new(0, 0.6, 0)
        local weldBase = Instance.new("WeldConstraint")
        weldBase.Name = "GuruHatWeldBase"; weldBase.Part0 = head; weldBase.Part1 = hatBase; weldBase.Parent = head
        local angles = {0, 90, 180, 270}
        for i, part in ipairs(coneParts) do
            local angle = math.rad(angles[i])
            part.CFrame = head.CFrame * CFrame.new(0, 1.4, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -0.55) * CFrame.Angles(math.rad(45), 0, 0)
            local weld = Instance.new("WeldConstraint")
            weld.Name = "GuruHatWeldSide" .. i
            weld.Part0 = head; weld.Part1 = part; weld.Parent = head
        end
    end
end
LocalPlayer.CharacterAdded:Connect(function() task.wait(0.5); attachHat(LocalPlayer.Character) end)
if LocalPlayer.Character then attachHat(LocalPlayer.Character) end

-- ===== Хук FireServer =====
local akbLastPos = nil
local function onAttackCall(self, ...)
    if not settings.aimbotEnabled then return nil end
    if settings.packetCritEnabled then doPacketCrit() end
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local targets = currentAttackTargets
    if #targets == 0 then return nil end
    local firstPayload = nil
    for i, target in ipairs(targets) do
        local targetHRP = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if targetHRP then
            local lookTurn = getLookTurn(targetHRP, myHRP)
            local payload
            if settings.aimbotMode == "Advanced" then
                local er = getEntityRenderer()
                if er and er.getPlayerEntityId then
                    local ok, id = pcall(er.getPlayerEntityId, target)
                    if ok and id then payload = buildPayload(id, lookTurn) end
                end
            end
            if not payload then
                payload = {
                    lookTurn = lookTurn, updateTick = math.floor(os.clock() * settings.tickRate),
                    fromUpdateTick = math.floor(os.clock() * settings.tickRate) - 1,
                    tick = math.floor(os.clock() * settings.tickRate), time = os.clock(),
                    swing = true, tickRate = settings.tickRate, combat = true, attack = true,
                }
            end
            if i == 1 then firstPayload = payload
            else task.spawn(function() pcall(function() attackRemote:FireServer(payload) end) end) end
            log("Attack[" .. i .. "/" .. #targets .. "]: " .. target.Name)
        end
    end
    return firstPayload
end

local hooked = false
if getrawmetatable then
    local ok, err = pcall(function()
        local mt = getrawmetatable(game); local oldNamecall = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" then
                if self == attackRemote then
                    local payload = onAttackCall(self, ...)
                    if payload then return oldNamecall(self, payload) end
                elseif self == moveRemote and settings.akbEnabled and not packetCritActive then
                    if not tpWalkActive then
                        local args = {...}; local pos = args[2]
                        if typeof(pos) == "Vector3" then
                            if akbLastPos then
                                local delta = (pos - akbLastPos).Magnitude
                                if delta > 5 then log("AKB: блок"); return end
                            end
                            akbLastPos = pos
                        end
                    end
                end
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true); hooked = true; log("Хук getrawmetatable OK")
    end)
    if not hooked then log("getrawmetatable FAIL: " .. tostring(err)) end
end
if not hooked and hookfunction then
    local ok, err = pcall(function()
        local oldFire = attackRemote.FireServer
        hookfunction(attackRemote.FireServer, function(self, ...)
            local payload = onAttackCall(self, ...)
            if payload then return oldFire(self, payload) end
            return oldFire(self, ...)
        end)
    end)
    if ok then hooked = true; log("Хук hookfunction OK") else log("hookfunction FAIL: " .. tostring(err)) end
end
if not hooked then log("Хук не установлен") end

