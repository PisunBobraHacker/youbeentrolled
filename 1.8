-- CORNER SQUARES (каждый кадр)
-- ============================================================
local MAX_SQUARES = 10
local squarePool = {}
for i = 1, MAX_SQUARES do
    local lines = {}
    for j = 1, 8 do
        local l = Drawing.new("Line"); l.Thickness = 2; l.Color = Color3.fromRGB(255, 255, 0)
        l.Transparency = 1; l.Visible = false; table.insert(lines, l)
    end
    squarePool[i] = {lines = lines, rotation = 0}
end
local function hideSquare(sq) for _, l in ipairs(sq.lines) do l.Visible = false end end
RunService.RenderStepped:Connect(function(dt)
    if not settings.targetSquareEnabled then
        for _, sq in ipairs(squarePool) do hideSquare(sq) end; return
    end
    local targets = currentAimbotTargets
    if #targets == 0 then for _, sq in ipairs(squarePool) do hideSquare(sq) end; return end
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    for i, sq in ipairs(squarePool) do
        local target = targets[i]
        if not target or not target.Character then hideSquare(sq)
        else
            local hrp = target.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then hideSquare(sq)
            else
                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if not onScreen then hideSquare(sq)
                else
                    sq.rotation = sq.rotation + dt * 3
                    local half = settings.squareSize / 2
                    local cosR = math.cos(sq.rotation); local sinR = math.sin(sq.rotation)
                    local cl = settings.cornerLength
                    local corners = {
                        Vector2.new(-half, -half), Vector2.new(half, -half),
                        Vector2.new(half, half), Vector2.new(-half, half),
                    }
                    local screenCorners = {}
                    for k, c in ipairs(corners) do
                        local rx = c.X * cosR - c.Y * sinR
                        local ry = c.X * sinR + c.Y * cosR
                        screenCorners[k] = Vector2.new(pos.X + rx, pos.Y + ry)
                    end
                    local inHitRange = false
                    if myHRP then
                        local dist = (myHRP.Position - hrp.Position).Magnitude
                        inHitRange = dist <= settings.hitRange
                    end
                    local color = inHitRange and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(255, 255, 0)
                    local idx = 1
                    for k = 1, 4 do
                        local c = screenCorners[k]
                        local prevK = k - 1; if prevK < 1 then prevK = 4 end
                        local nextK = k + 1; if nextK > 4 then nextK = 1 end
                        local prevCorner = screenCorners[prevK]
                        local nextCorner = screenCorners[nextK]
                        local dirPrev = (prevCorner - c).Unit * cl
                        local dirNext = (nextCorner - c).Unit * cl
                        local l1 = sq.lines[idx]; l1.From = c; l1.To = c + dirPrev; l1.Color = color; l1.Visible = true; idx = idx + 1
                        local l2 = sq.lines[idx]; l2.From = c; l2.To = c + dirNext; l2.Color = color; l2.Visible = true; idx = idx + 1
                    end
                end
            end
        end
    end
end)

