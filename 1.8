-- ===== Цели =====
local function getTargets()
    local t = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then table.insert(t, {plr = plr, hrp = hrp, hum = hum}) end
        end
    end
    return t
end

local function getNearestN(count, maxDist)
    local myChar = LocalPlayer.Character
    if not myChar then return {} end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return {} end
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (myHRP.Position - hrp.Position).Magnitude
                if d <= maxDist then table.insert(list, {plr = plr, hrp = hrp, dist = d}) end
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    local result = {}
    for i = 1, math.min(count, #list) do table.insert(result, list[i].plr) end
    return result
end

local function getAttackableN(count, hitRange)
    local myChar = LocalPlayer.Character
    if not myChar then return {} end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return {} end
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (myHRP.Position - hrp.Position).Magnitude
                if d <= hitRange then table.insert(list, {plr = plr, hrp = hrp, dist = d}) end
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    local result = {}
    for i = 1, math.min(count, #list) do table.insert(result, list[i].plr) end
    return result
end

local currentAimbotTargets, currentAimbotTarget, currentAttackTargets = {}, nil, {}

-- ===== ESP / Chams / Tracers (каждый кадр) =====
local chamsFolder = Instance.new("Folder"); chamsFolder.Name = "ChamsFolder"; chamsFolder.Parent = game.CoreGui
local espCache = {}
local function createChams(character)
    local hl = Instance.new("Highlight")
    hl.Adornee = character; hl.FillColor = Color3.fromRGB(255, 0, 0)
    hl.FillTransparency = 0.35; hl.OutlineColor = Color3.fromRGB(255, 0, 0)
    hl.OutlineTransparency = 0.1; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = chamsFolder; return hl
end
local function createTracer()
    local line = Drawing.new("Line"); line.Thickness = 1; line.Color = Color3.fromRGB(255, 100, 100)
    line.Transparency = 0.6; line.Visible = false; return line
end
local function updateESP()
    if not settings.espEnabled then
        for _, d in pairs(espCache) do
            if d.hl then d.hl.Enabled = false end
            if d.name then d.name.Visible = false end
            if d.tracer then d.tracer.Visible = false end
        end
        return
    end
    local targets = getTargets(); local seen = {}
    for _, t in ipairs(targets) do
        local char = t.plr.Character; seen[char] = true
        if not espCache[char] then
            local nameText = Drawing.new("Text"); nameText.Size = 14; nameText.Center = true
            nameText.Outline = true; nameText.Color = Color3.fromRGB(255, 255, 255); nameText.Visible = false
            espCache[char] = {hl = createChams(char), name = nameText, tracer = createTracer()}
        end
        local d = espCache[char]
        local pos, onScreen = Camera:WorldToViewportPoint(t.hrp.Position)
        if onScreen then
            local dist = (Camera.CFrame.Position - t.hrp.Position).Magnitude
            d.hl.Enabled = true
            d.name.Text = string.format("%s [%dm]", t.plr.Name, math.floor(dist))
            d.name.Position = Vector2.new(pos.X, pos.Y - 40); d.name.Visible = true
            if settings.tracerEnabled then
                local ss = Camera.ViewportSize
                d.tracer.From = Vector2.new(ss.X / 2, ss.Y)
                d.tracer.To = Vector2.new(pos.X, pos.Y); d.tracer.Visible = true
            else d.tracer.Visible = false end
        else
            d.hl.Enabled = false; d.name.Visible = false; d.tracer.Visible = false
        end
    end
    for char, d in pairs(espCache) do
        if not seen[char] or not char.Parent then
            if d.hl then d.hl:Destroy() end
            if d.name then d.name:Remove() end
            if d.tracer then d.tracer:Remove() end
            espCache[char] = nil
        end
    end
end
RunService.RenderStepped:Connect(updateESP)

