-- ===== Лог =====
local consoleLines = {}
local MAX_CONSOLE_LINES = 400
local consoleLabel = nil
local function log(msg)
    local line = "[" .. os.date("%H:%M:%S") .. "] " .. tostring(msg)
    table.insert(consoleLines, line)
    if #consoleLines > MAX_CONSOLE_LINES then table.remove(consoleLines, 1) end
    print(line)
    if consoleLabel then
        task.spawn(function()
            consoleLabel.Text = table.concat(consoleLines, "\n")
            task.wait()
            local scroll = consoleLabel.Parent
            if scroll and scroll:IsA("ScrollingFrame") then
                scroll.CanvasPosition = Vector2.new(0, scroll.AbsoluteCanvasSize.Y)
            end
        end)
    end
end

-- ===== EntityRenderer =====
local EntityRenderer = nil
local function getEntityRenderer()
    if EntityRenderer then return EntityRenderer end
    local er = ReplicatedStorage:FindFirstChild("Client")
        and ReplicatedStorage.Client:FindFirstChild("Controller")
        and ReplicatedStorage.Client.Controller:FindFirstChild("EntityRenderer")
    if not er then log("EntityRenderer не найден"); return nil end
    local ok, mod = pcall(require, er)
    if not ok or type(mod) ~= "table" then
        log("require EntityRenderer не сработал: " .. tostring(mod)); return nil
    end
    EntityRenderer = mod; log("EntityRenderer загружен"); return EntityRenderer
end

